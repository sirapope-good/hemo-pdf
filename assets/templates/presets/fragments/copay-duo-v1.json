  "displayName": "Co-pay banner + NHSO/SSO",
  "tags": ["clinical", "copay"],
  "elements": [
    {
      "id": "copay-banner",
      "type": "box-text",
      "band": "content",
      "place": "below",
      "box": { "xMm": 0, "yMm": 0, "wMm": 206, "hMm": 5 },
      "text": "ปริมาณยาที่มีสิทธิได้รับโดยไม่ต้องร่วมจ่าย",
