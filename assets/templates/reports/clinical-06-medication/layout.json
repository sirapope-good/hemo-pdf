{
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "marginMm": 8,
    "spacingMode": "custom",
    "spacingMm": 0,
    "spacingBelowMm": 1,
    "spacingBesideMm": 0,
    "border": "none"
  },
  "elements": [
    {
      "id": "hdr",
      "type": "header",
      "band": "header",
      "preset": "clinical-header-thaiur",
      "place": "below",
      "box": { "xMm": 0, "yMm": 0, "wMm": 194, "hMm": 27 }
    },
    {
      "id": "med-grid",
      "type": "data-grid",
      "band": "content",
      "place": "below",
      "bindRows": "$.rows",
      "columnHeadersBind": "$.columnHeaders",
      "box": { "xMm": 0, "yMm": 0, "wMm": 194, "hMm": 246 },
      "chrome": {
        "headerFill": "$branding.sectionHeaderBackground",
        "border": "thin",
        "fontSize": 7,
        "rowHeightMm": 5.2,
        "columnWidths": ["3.2", "2.2", "1.6", "*", "*", "*", "*", "*"]
      }
    },
    {
      "id": "review-note",
      "type": "box-text",
      "band": "content",
      "place": "below",
      "text": "**Review Med : Anti HT-DM-Heart-Other",
      "bind": "$.reviewNote",
      "align": "right",
      "box": { "xMm": 0, "yMm": 0, "wMm": 194, "hMm": 6 },
      "chrome": { "border": "none", "fontSize": 8 }
    }
  ]
}
