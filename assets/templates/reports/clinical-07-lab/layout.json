{
  "page": {
    "size": "A4",
    "marginMm": 8
  },
  "header": {
    "widget": "thaiur.header"
  },
  "body": [
    {
      "type": "data-grid",
      "columnHeadersBind": "$.columnHeaders",
      "bindRows": "$.rows",
      "chrome": {
        "headerFill": "$branding.sectionHeaderBackground",
        "border": "thin",
        "fontSize": 7,
        "rowHeightMm": 5,
        "columnWidths": ["3", "*", "*", "*", "*", "*", "*"]
      }
    }
  ]
}
