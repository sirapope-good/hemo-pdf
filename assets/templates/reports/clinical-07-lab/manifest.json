{
  "id": "clinical-07-lab",
  "version": "1.0.0",
  "displayName": "Laboratory Record",
  "engineVersion": 1,
  "layoutMode": "designer",
  "dataAdapter": "flatten-dto",
  "requiresSignature": false,
  "language": "th",
  "ui": {
    "entryMode": "patient",
    "menuGroup": "clinical",
    "sortOrder": 70,
    "visibleInMenu": true,
    "parameters": [
      {
        "name": "from",
        "source": "default",
        "generator": "lastMonths",
        "months": 6
      },
      {
        "name": "to",
        "source": "default",
        "generator": "today"
      }
    ],
    "reportDataPath": "api/Patients/{patientId}/reports/{templateId}/report-data"
  }
}
