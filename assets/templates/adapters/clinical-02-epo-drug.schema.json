        { "path": "rows[].dateLabel", "label": "Date", "type": "string" },
        { "path": "rows[].doseIndex", "label": "Dose index", "type": "number" },
        { "path": "rows[].stickerText", "label": "Sticker", "type": "string" },
        { "path": "rows[].nurseName", "label": "Nurse", "type": "string" },
        { "path": "rows[].remarks", "label": "Remarks", "type": "string" }
