{
  "page": {
    "size": "A4",
    "marginMm": 10
  },
  "body": [
    {
      "type": "text",
      "style": "title",
      "bind": "$title"
    },
    {
      "type": "field-grid",
      "columns": 2,
      "fields": [
        {
          "label": { "$label": "hn" },
          "bind": "$.patient.hn"
        },
        {
          "label": { "$label": "patientName" },
          "bind": "$.patient.name"
        },
        {
          "label": { "$label": "unit" },
          "bind": "$.patient.unit"
        },
        {
          "label": { "$label": "reportDate" },
          "bind": "$.reportDate"
        }
      ]
    },
    {
      "type": "key-value-table",
      "appendFlatten": true
    },
    {
      "type": "signature"
    }
  ]
}
