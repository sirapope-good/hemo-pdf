{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemopro.local/schemas/hprp-manifest.json",
  "title": "HPRP manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "engineVersion", "dataAdapter"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "variant": { "type": "string" },
    "layoutKind": {
      "type": "string",
      "enum": ["DefaultForm", "ThaiUrForm", "UniquePlanner"]
    },
    "layoutProfile": { "type": "string" },
    "version": { "type": "string" },
    "displayName": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "dataAdapter": {
      "type": "string",
      "enum": [
        "flatten-dto",
        "hemosheet-record",
        "clinical-01-hct-epo",
        "clinical-02-epo-drug",
        "clinical-05-progress-note",
        "clinical-05-progress-note-checklist",
        "consent",
        "medicine-preparation-round"
      ]
    },
    "requiresSignature": { "type": "boolean" },
    "language": { "type": "string" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entryMode": {
          "type": "string",
          "enum": [
            "hemosheetList",
            "patient",
            "patientMonth",
            "patientYear",
            "unitDateRound"
          ]
        },
        "menuGroup": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "visibleInMenu": { "type": "boolean" },
        "role": { "type": "string", "enum": ["hemosheetLayoutProfile"] },
        "profileLabel": { "type": "string" },
        "reportDataPath": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source": {
                "type": "string",
                "enum": ["route", "query", "constant", "default"]
              },
              "routeKey": { "type": "string" },
              "format": { "type": "string" },
              "generator": {
                "type": "string",
                "enum": ["today", "lastMonths"]
              },
              "months": { "type": "integer", "minimum": 1 },
              "required": { "type": "boolean" },
              "value": {}
            }
          }
        }
      }
    }
  }
}
