{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemopro.local/schemas/hprp-layout.json",
  "title": "HPRP layout",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "object",
      "properties": {
        "size": { "type": "string" },
        "marginMm": { "type": "number" }
      }
    },
    "header": { "$ref": "#/$defs/node" },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["field-grid", "key-value-table", "data-grid", "text", "signature", "patient-info"]
        },
        "widget": { "type": "string" },
        "when": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "title": true,
        "content": true,
        "bind": { "type": "string" },
        "bindRows": { "type": "string" },
        "style": { "type": "string" },
        "columns": { "type": "integer" },
        "columnHeaders": { "type": "array", "items": { "type": "string" } },
        "columnHeadersBind": { "type": "string" },
        "fields": { "type": "array" },
        "rows": { "type": "array" },
        "appendFlatten": { "type": "boolean" },
        "variant": { "type": "string" },
        "chrome": { "$ref": "#/$defs/chrome" },
        "columnPlan": {
          "type": "array",
          "description": "Ordered entry columns for dense table recipes. Empty/omitted = widget default. Not field-grid columns (integer) or hemosheet section columns (string[]).",
          "items": { "$ref": "#/$defs/columnPlanItem" }
        }
      }
    },
    "columnPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "string",
          "description": "Recipe field id (e.g. hb, hct). Empty = handwriting blank column."
        },
        "labelKey": { "type": "string" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "center": { "type": "boolean" },
        "isLab": { "type": "boolean" }
      }
    },
    "section": {
      "type": "object",
      "required": ["widget"],
      "properties": {
        "widget": { "type": "string" },
        "when": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "variant": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "columnsWhen": { "type": "object" },
        "fixedLinesFrom": { "type": "string" },
        "chrome": { "$ref": "#/$defs/chrome" }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headerFill": {
          "type": "string",
          "description": "#RRGGBB or $branding.sectionHeaderBackground"
        },
        "border": { "type": "string", "enum": ["none", "thin", "medium"] },
        "fontSize": { "type": "number" },
        "rowHeightMm": { "type": "number" },
        "columnWidths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative weights; * = 1. Applied when count matches columns."
        }
      }
    }
  }
}
