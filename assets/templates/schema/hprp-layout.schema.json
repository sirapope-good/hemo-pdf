{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemopro.local/schemas/hprp-layout.json",
  "title": "HPRP layout",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "object",
      "properties": {
        "size": { "type": "string" },
        "marginMm": { "type": "number" }
      }
    },
    "header": { "$ref": "#/$defs/node" },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["field-grid", "key-value-table", "data-grid", "text", "signature", "patient-info"]
        },
        "widget": { "type": "string" },
        "when": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "title": true,
        "content": true,
        "bind": { "type": "string" },
        "bindRows": { "type": "string" },
        "style": { "type": "string" },
        "columns": { "type": "integer" },
        "columnHeaders": { "type": "array", "items": { "type": "string" } },
        "columnHeadersBind": { "type": "string" },
        "fields": { "type": "array" },
        "rows": { "type": "array" },
        "appendFlatten": { "type": "boolean" },
        "variant": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "required": ["widget"],
      "properties": {
        "widget": { "type": "string" },
        "when": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "variant": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "columnsWhen": { "type": "object" },
        "fixedLinesFrom": { "type": "string" }
      }
    }
  }
}
