{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hemopro.local/schemas/hprp-layout.json",
  "title": "HPRP layout",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "string" },
        "marginMm": { "type": "number", "minimum": 0, "maximum": 80 },
        "margin": { "$ref": "#/$defs/sides" },
        "spacingMm": { "type": "number", "minimum": 0, "maximum": 80 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 48 }
      }
    },
    "header": { "$ref": "#/$defs/node" },
    "body": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "sides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number", "minimum": 0, "maximum": 80 },
        "right": { "type": "number", "minimum": 0, "maximum": 80 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 80 },
        "left": { "type": "number", "minimum": 0, "maximum": 80 }
      }
    },
    "inset": {
      "description": "CSS-like mm: number, [v,h], [t,r,b,l], or named sides",
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 80 },
        { "type": "array", "items": { "type": "number" }, "minItems": 1, "maxItems": 4 },
        { "$ref": "#/$defs/sides" }
      ]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marginMm": { "$ref": "#/$defs/inset" },
        "paddingMm": { "$ref": "#/$defs/inset" }
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["field-grid", "key-value-table", "data-grid", "text", "signature", "patient-info", "row", "column-stack"]
        },
        "widget": { "type": "string" },
        "when": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "title": true,
        "content": true,
        "bind": { "type": "string" },
        "bindRows": { "type": "string" },
        "style": { "type": "string" },
        "columns": { "type": "integer" },
        "columnHeaders": { "type": "array", "items": { "type": "string" } },
        "columnHeadersBind": { "type": "string" },
        "fields": { "type": "array" },
        "rows": { "type": "array" },
        "appendFlatten": { "type": "boolean" },
        "variant": { "type": "string" },
        "chrome": { "$ref": "#/$defs/chrome" },
        "box": { "$ref": "#/$defs/box" },
        "gapMm": { "type": "number", "minimum": 0, "maximum": 80 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "columnPlan": {
          "type": "array",
          "description": "Ordered entry columns for dense table recipes. Empty/omitted = widget default. Not field-grid columns (integer) or hemosheet section columns (string[]).",
          "items": { "$ref": "#/$defs/columnPlanItem" }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "string",
          "description": "*, 40%, or 32mm"
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "columnPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "string",
          "description": "Recipe field id (e.g. hb, hct). Empty = handwriting blank column."
        },
        "labelKey": { "type": "string" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "center": { "type": "boolean" },
        "isLab": { "type": "boolean" }
      }
    },
    "section": {
      "type": "object",
      "required": ["widget"],
      "properties": {
        "widget": { "type": "string" },
        "when": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "variant": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "columnsWhen": { "type": "object" },
        "fixedLinesFrom": { "type": "string" },
        "chrome": { "$ref": "#/$defs/chrome" }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headerFill": {
          "type": "string",
          "description": "#RRGGBB or $branding.sectionHeaderBackground"
        },
        "border": { "type": "string", "enum": ["none", "thin", "medium"] },
        "fontSize": { "type": "number" },
        "rowHeightMm": { "type": "number" },
        "headerHeightMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 80 },
        "headerAlign": { "type": "string", "enum": ["top", "middle", "bottom"] },
        "headerPaddingMm": { "type": "number", "minimum": 0, "maximum": 80 },
        "columnWidths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative weights; * = 1. Applied when count matches columns."
        },
        "bandWeights": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    }
  }
}
