{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HemoPdf": {
    "UseMockServices": true,
    "UseServerFetch": true,
    "BrandingRootPath": "assets/branding",
    "TemplatesRootPath": "assets/templates",
    "PackagesRootPath": "packages",
    "EnableHprpStudioWrite": true,
    "WebApi": {
      "BaseUrl": "http://localhost:8200"
    },
    "CorsOrigins": [
      "http://localhost:4200",
      "http://localhost:4500",
      "http://127.0.0.1:4200",
      "http://127.0.0.1:4500",
      "http://localhost:5000"
    ]
  }
}
